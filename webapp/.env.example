# Build-time values. Copy to .env (git-ignored) and fill in; unlike
# public/config.js, these are read when the app is built, so a change needs a
# new build.
#
# Keeping a value here keeps it out of this public repo only: Vite copies it
# into the built JavaScript, so anyone who opens the app can read it.

# Email signature: for one person whose signature address isn't their work
# email's username — their work email, and the username their signature's
# email should use. The signature template adds the domain.
# ONE_WSO2_EMAIL_SIGNATURE_OVERRIDE_WORK_EMAIL=jdoe2@wso2.com
# ONE_WSO2_EMAIL_SIGNATURE_OVERRIDE_EMAIL_USER=jdoe
